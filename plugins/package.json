{
  "name": "pvisor-agent-plugins",
  "version": "0.1.12",
  "description": "Task-level pVisor staging adapters for Pi, DSH and Codex",
  "license": "Apache-2.0",
  "homepage": "https://deeplink-org.github.io/pvisor/guides/agents/plugins/",
  "repository": { "type": "git", "url": "git+https://github.com/DeepLink-org/pvisor.git", "directory": "plugins" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "keywords": ["pi-package", "dsh-plugin", "codex", "sandbox", "pvisor"],
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "exports": {
    ".": "./dsh.mjs",
    "./pi": "./pi.mjs",
    "./dsh": "./dsh.mjs",
    "./client": "./dsh-client.js"
  },
  "bin": {
    "pvisor-agent-mcp": "./mcp.mjs",
    "pvisor-agent-fanout": "./fanout-cli.mjs"
  },
  "pi": { "extensions": ["./pi.mjs"] },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-session"]
    }
  },
  "peerDependencies": { "@deepseek-ai/dsh-tools": "^0.2.0-0 || ^0.2.1-0 || ^0.2.2-0" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-tools": { "optional": true } },
  "files": [
    "backend.mjs",
    "tools.mjs",
    "pi.mjs",
    "dsh.mjs",
    "dsh-monitor.mjs",
    "dsh-client.js",
    "mcp.mjs",
    "runtime.mjs",
    "environment.mjs",
    "execution.mjs",
    "presentation.mjs",
    "review.mjs",
    "file-review.mjs",
    "fanout.mjs",
    "fanout-cli.mjs",
    "cordis.patch.yml",
    "plugin.json",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "install-prompt.txt"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:hosts": "node check-hosts.mjs",
    "test:monitor": "node check-dsh-monitor.mjs",
    "smoke": "node smoke.mjs"
  }
}
