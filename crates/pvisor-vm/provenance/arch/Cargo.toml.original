[package]
edition = "2021"
name = "krun-arch"
version = "0.1.0-1.19.3"
authors = ["The libkrun Authors"]
build = false
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "Architecture-specific VM support for libkrun"
readme = false
license = "Apache-2.0"
repository = "https://github.com/containers/libkrun"

[features]
amd-sev = ["tee"]
efi = []
tdx = [
    "tee",
    "dep:tdx",
]
tee = []

[lib]
name = "krun_arch"
path = "src/lib.rs"

[dependencies.arch_gen]
version = "=0.1.0-1.19.3"
package = "krun-arch-gen"

[dependencies.libc]
version = ">=0.2.39"

[dependencies.smbios]
version = "=0.1.0-1.19.3"
package = "krun-smbios"

[dependencies.utils]
version = "=0.1.0-1.19.3"
package = "krun-utils"

[dependencies.vm-memory]
version = "0.17"
features = ["backend-mmap"]

[dependencies.vmm-sys-util]
version = "0.14"

[dev-dependencies.utils]
version = "=0.1.0-1.19.3"
package = "krun-utils"

[target.'cfg(target_os = "linux")'.dependencies.kvm-bindings]
version = "0.12"
features = ["fam-wrappers"]

[target.'cfg(target_os = "linux")'.dependencies.kvm-ioctls]
version = "0.22"

[target.'cfg(target_os = "linux")'.dependencies.tdx]
version = "0.1.0"
optional = true
