[environments]
enabled = true

[overlaynet]
mode = "off"
policy = "deny"

[admission]
mode = "linux_pressure"
memory_reserve_bytes = 134217728
# Logical CPU reservations may total 2 CPUs under a 1-CPU kernel quota.
cpu_overcommit_bps = 20000
cpu_some_avg10_limit_bps = 5000
memory_full_avg10_limit_bps = 100
max_sample_age_ms = 3000

[memory_sampling]
enabled = true
interval_ms = 5000

# Dynamic Linux builds require an installed libkrunfw. Set library_dir in [vm]
# when the firmware is outside the loader's default locations.
