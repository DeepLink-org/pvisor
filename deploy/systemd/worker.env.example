PVISOR_CLUSTER_WORKER_TOKEN=replace-with-controller-worker-token
PVISOR_CLUSTER_URL=http://127.0.0.1:19800
PVISOR_WORKER_SLOTS=2
PVISOR_WORKER_MEMORY_BYTES=536870912
PVISOR_WORKER_CPU_MILLIS=2000
PVISOR_CACHE_BACKEND=filesystem
# Set an absolute host-owned cache path shared by this Worker's environments.
PVISOR_CACHE_LOCATION=/absolute/path/to/pvisor-cache
