+/* WILLNEED/readahead(2) must not feed lower bytes to the merged cache. */
+static int fuse_pvisor_fadvise(struct file *file, loff_t offset, loff_t len,
+			       int advice)
+{
+	struct fuse_file *ff = file->private_data;
+	struct file *data;
+	int err;
+
+	if (!ff->fm->fc->pvisor_data_object)
+		return generic_fadvise(file, offset, len, advice);
+	err = fuse_pvisor_bind(file);
+	if (err)
+		return err;
+	if (!(ff->open_flags & FOPEN_PVISOR_DATA_OBJECT))
+		return generic_fadvise(file, offset, len, advice);
+	data = fuse_pvisor_data_file(file);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+	return vfs_fadvise(data, offset, len, advice);
+}
