+/* A partial native read must not turn an immutable receipt into a new EOF. */
+static bool fuse_pvisor_early_short(struct inode *inode, loff_t pos,
+				    size_t num_read, size_t count)
+{
+	loff_t size = i_size_read(inode);
+	size_t expected = pos >= size ? 0 : min_t(u64, count, size - pos);
+
+	return num_read < expected;
+}
