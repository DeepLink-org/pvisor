+/* The receipt is validated without consulting merged inode size. */
+static int fuse_pvisor_data_valid(struct inode *inode, struct fuse_file *ff,
+				  unsigned int flags)
+{
+	struct fuse_conn *fc = ff->fm->fc;
+
+	if (!(ff->open_flags & FOPEN_PVISOR_DATA_OBJECT))
+		return 0;
+	if (!fc->pvisor_data_object || fc->writeback_cache ||
+	    !fc->no_lock || !fc->no_flock || FUSE_IS_DAX(inode) ||
+	    !S_ISREG(inode->i_mode) || (flags & (O_ACCMODE | O_TRUNC)) ||
+	    (ff->open_flags & (FOPEN_DIRECT_IO | FOPEN_PASSTHROUGH |
+			       FOPEN_NONSEEKABLE | FOPEN_STREAM)) ||
+	    !ff->pvisor_data_id || ff->pvisor_data_size > inode->i_sb->s_maxbytes)
+		return -EIO;
+	return 0;
+}
+
+static int fuse_pvisor_data_eq(struct inode *inode, void *data)
+{
+	return get_fuse_inode(inode)->pvisor_data_id == *(u32 *)data;
+}
+
+static int fuse_pvisor_data_set(struct inode *inode, void *data)
+{
+	get_fuse_inode(inode)->pvisor_data_id = *(u32 *)data;
+	return 0;
+}
+
+/* Prepare under the namespace open lock; allocation never retries OPEN. */
+static struct file *fuse_pvisor_data_file(struct file *user_file)
+{
+	struct fuse_file *ff = user_file->private_data;
+	struct inode *ns = file_inode(user_file), *inode;
+	struct fuse_inode *fi = get_fuse_inode(ns);
+	struct file *file;
+	struct path path;
+
+	mutex_lock(&fi->pvisor_open_lock);
+	file = ff->pvisor_data_file;
+	if (file)
+		goto out;
+	inode = ff->pvisor_data_inode;
+	if (!inode) {
+		inode = iget5_locked(ns->i_sb, ff->pvisor_data_id,
+				    fuse_pvisor_data_eq, fuse_pvisor_data_set,
+				    &ff->pvisor_data_id);
+		if (!inode) {
+			file = ERR_PTR(-ENOMEM);
+			goto out;
+		}
+		if (inode->i_state & I_NEW) {
+			inode->i_ino = ff->pvisor_data_id;
+			inode->i_mode = S_IFREG | 0444;
+			inode->i_flags |= S_NOATIME | S_NOCMTIME;
+			set_nlink(inode, 1);
+			i_size_write(inode, ff->pvisor_data_size);
+			fuse_init_file_inode(inode, 0);
+			inode->i_fop = &fuse_pvisor_data_fops;
+			inode->i_mapping->a_ops = &fuse_pvisor_data_aops;
+			unlock_new_inode(inode);
+		} else if (i_size_read(inode) != ff->pvisor_data_size) {
+			iput(inode);
+			file = ERR_PTR(-EIO);
+			goto out;
+		}
+		ff->pvisor_data_inode = inode;
+		ff->pvisor_namespace_inode = ns;
+	}
+	path.dentry = d_alloc_anon(ns->i_sb);
+	if (!path.dentry) {
+		file = ERR_PTR(-ENOMEM);
+		goto out;
+	}
+	d_instantiate(path.dentry, igrab(inode));
+	path.mnt = user_file->f_path.mnt;
+	file = backing_file_open(user_file, user_file->f_flags, &path,
+				 user_file->f_cred);
+	dput(path.dentry);
+	if (!IS_ERR(file)) {
+		file->f_mode |= FMODE_CAN_ODIRECT;
+		/* The inner file owns a ref distinct from the outer fd. */
+		file->private_data = fuse_file_get(ff);
+		ff->pvisor_data_file = file;
+	}
+out:
+	if (!IS_ERR(file)) {
+		/* F_SETFL may change O_DIRECT after the native OPEN. */
+		spin_lock(&file->f_lock);
+		file->f_flags = (file->f_flags & ~O_DIRECT) |
+			(user_file->f_flags & O_DIRECT);
+		file->f_iocb_flags = iocb_flags(file);
+		spin_unlock(&file->f_lock);
+	}
+	mutex_unlock(&fi->pvisor_open_lock);
+	return file;
+}
+
+static void fuse_pvisor_read_atime(struct fuse_file *ff, struct inode *inode)
+{
+	if (ff && inode == ff->pvisor_data_inode)
+		inode = ff->pvisor_namespace_inode;
+	fuse_invalidate_atime(inode);
+}
+
+static int fuse_pvisor_data_release(struct inode *inode, struct file *file)
+{
+	struct fuse_file *ff = file->private_data;
+
+	if (ff)
+		fuse_file_put(ff, ff->fm->fc->auto_submounts);
+	return 0;
+}
+
+/* A procfs magic link must not grant an unchecked data-object open. */
+static int fuse_pvisor_data_open(struct inode *inode, struct file *file)
+{
+	return (file->f_mode & FMODE_BACKING) ? 0 : -EACCES;
+}
+
+static ssize_t fuse_pvisor_data_read_iter(struct kiocb *iocb, struct iov_iter *to)
+{
+	if (!iocb->ki_filp->private_data)
+		return -EIO;
+	if (iocb->ki_flags & IOCB_DIRECT)
+		return fuse_direct_read_iter(iocb, to);
+	return generic_file_read_iter(iocb, to);
+}
+
+static ssize_t fuse_pvisor_data_splice(struct file *file, loff_t *ppos,
+		struct pipe_inode_info *pipe, size_t len, unsigned int flags)
+{
+	if (!file->private_data)
+		return -EIO;
+	return filemap_splice_read(file, ppos, pipe, len, flags);
+}
+
+static int fuse_pvisor_data_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	if (!file->private_data)
+		return -EIO;
+	return generic_file_readonly_mmap(file, vma);
+}
+
+static loff_t fuse_pvisor_data_llseek(struct file *file, loff_t off, int whence)
+{
+	if (!file->private_data)
+		return -EIO;
+	return generic_file_llseek(file, off, whence);
+}
+
+static const struct file_operations fuse_pvisor_data_fops = {
+	.open = fuse_pvisor_data_open,
+	.read_iter = fuse_pvisor_data_read_iter,
+	.splice_read = fuse_pvisor_data_splice,
+	.mmap = fuse_pvisor_data_mmap,
+	.llseek = fuse_pvisor_data_llseek,
+	.release = fuse_pvisor_data_release,
+};
