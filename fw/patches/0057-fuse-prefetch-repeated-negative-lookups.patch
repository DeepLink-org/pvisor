Subject: [PATCH] fuse: continue bounded directory prefetch on sustained host misses

diff --git a/fs/fuse/dir.c b/fs/fuse/dir.c
index b1bcc5a..5025f6c 100644
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -451,6 +451,8 @@ static struct dentry *fuse_lookup(struct inode *dir, struct dentry *entry,
 		err = fuse_lookup_name(dir->i_sb, get_node_id(dir), &entry->d_name,
 				       &outarg, &inode);
 		fuse_unlock_inode(dir, locked);
+		if (err == -ENOENT && get_fuse_conn(dir)->pvisor_meta)
+			pvisor_note_lookup_miss(dir, &entry->d_name);
 	}
 	if (err == -ENOENT) {
 		outarg_valid = false;
diff --git a/fs/fuse/fuse_i.h b/fs/fuse/fuse_i.h
index e2b1e0e..181eb77 100644
--- a/fs/fuse/fuse_i.h
+++ b/fs/fuse/fuse_i.h
@@ -1103,6 +1103,7 @@ int fuse_lookup_name(struct super_block *sb, u64 nodeid, const struct qstr *name
 
 int pvisor_lookup(struct inode *dir, struct dentry *entry,
 		  struct fuse_entry_out *outarg, struct inode **inode);
+void pvisor_note_lookup_miss(struct inode *dir, const struct qstr *name);
 void pvisor_note_create(struct inode *dir, const struct qstr *name,
 			struct fuse_entry_out *outarg);
 void pvisor_note_unlink(struct inode *dir, const struct qstr *name);
diff --git a/fs/fuse/pvisor_meta.c b/fs/fuse/pvisor_meta.c
index 368686f..359c870 100644
--- a/fs/fuse/pvisor_meta.c
+++ b/fs/fuse/pvisor_meta.c
@@ -23,6 +23,9 @@
 /* Matches FUSE_MAX_MAX_PAGES and the host's 1 MiB request buffer. */
 #define PVISOR_MAX_TRANSFER_PAGES 256U
 #define PVISOR_LOOKUP_PAGES 4U
+#define PVISOR_REPEAT_MISSES 4U
+#define PVISOR_CONTINUE_MISSES 16U
+static const unsigned int miss_window_pages[] = { 4, 16, 64, 128 };
 
 struct pvisor_entry {
 	struct rb_node node;
@@ -50,6 +53,9 @@ struct pvisor_dir {
 	u64 max_cookie;
 	u32 count;
 	u64 last_lookup;
+	u64 missing_name;
+	u8 missing_count;
+	u8 miss_windows;
 	unsigned int lookup_pages;	u32 lookup_misses;
 	u32 lookup_hits;
 	u32 lookup_entries;
@@ -518,6 +524,31 @@ out:
 	pvisor_free_pages(pages, npages, descs);
 	return err;
 }
+/* The hash is only an admission hint. READINDEX supplies the actual names. */
+void pvisor_note_lookup_miss(struct inode *dir, const struct qstr *name)
+{
+	struct fuse_inode *fi = get_fuse_inode(dir);
+	struct pvisor_dir *pd;
+
+	if (READ_ONCE(get_fuse_conn(dir)->pvisor_no_readindex))
+		return;
+	spin_lock(&fi->lock);
+	pd = fi->pvisor;
+	spin_unlock(&fi->lock);
+	if (!pd)
+		return;
+	mutex_lock(&pd->lock);
+	if (!pd->complete && !pd->passthrough && pd->miss_windows < ARRAY_SIZE(miss_window_pages)) {
+		if (!pd->miss_windows && pd->missing_name != name->hash_len) {
+			pd->missing_name = name->hash_len;
+			pd->missing_count = 0;
+		}
+		if (pd->missing_count < PVISOR_CONTINUE_MISSES)
+			pd->missing_count++;
+	}
+	mutex_unlock(&pd->lock);
+}
+
 int pvisor_lookup(struct inode *dir, struct dentry *entry,
 		  struct fuse_entry_out *outarg, struct inode **inode)
 {
@@ -526,6 +557,7 @@ int pvisor_lookup(struct inode *dir, struct dentry *entry,
 	unsigned int pages;
 	u32 hits, entries;
 	bool fetched = false;
+	bool miss_import = false;
 	int err = -EAGAIN;
 
 	*inode = NULL;
@@ -594,26 +626,37 @@ int pvisor_lookup(struct inode *dir, struct dentry *entry,
 			err = 0;
 			break;
 		}
-		if (fetched || !pd->lookup_pages)
-			break;
-		/* Hash collisions only defer prefetch; names still use real LOOKUP. */
-		if (pd->lookup_seen && pd->last_lookup == entry->d_name.hash_len)
-			break;
-		pd->lookup_seen = true;
-		pd->last_lookup = entry->d_name.hash_len;
-		/* Directory size is only an admission hint, never a name count. */
-		if (++pd->lookup_misses <
-		    clamp_t(loff_t, i_size_read(dir) >> 10, 4, 64))
+		if (fetched)
 			break;
 		hits = atomic_read(&get_fuse_inode(dir)->pvisor_prefetch_hits);
-		/* Stop sparse/strided access before growing a mostly unused window. */
-		if (pd->lookup_entries &&
-		    hits - pd->lookup_hits < max(1U, pd->lookup_entries * 3 / 4)) {
-			pd->lookup_pages = 0;
-			break;
+		if ((!pd->miss_windows && pd->missing_count >= PVISOR_REPEAT_MISSES &&
+		     pd->missing_name == entry->d_name.hash_len) ||
+		    (pd->miss_windows && pd->miss_windows < ARRAY_SIZE(miss_window_pages) &&
+		     pd->next_offset && pd->missing_count >= PVISOR_CONTINUE_MISSES)) {
+			pages = miss_window_pages[pd->miss_windows++];
+			pd->missing_count = 0;
+			miss_import = true;
+		} else {
+			if (!pd->lookup_pages)
+				break;
+			/* Hash collisions only defer prefetch; names still use real LOOKUP. */
+			if (pd->lookup_seen && pd->last_lookup == entry->d_name.hash_len)
+				break;
+			pd->lookup_seen = true;
+			pd->last_lookup = entry->d_name.hash_len;
+			/* Directory size is only an admission hint, never a name count. */
+			if (++pd->lookup_misses <
+			    clamp_t(loff_t, i_size_read(dir) >> 10, 4, 64))
+				break;
+			/* Stop sparse/strided access before growing a mostly unused window. */
+			if (pd->lookup_entries &&
+			    hits - pd->lookup_hits < max(1U, pd->lookup_entries * 3 / 4)) {
+				pd->lookup_pages = 0;
+				break;
+			}
+			pages = pd->lookup_pages;
 		}
 		entries = pd->count;
-		pages = pd->lookup_pages;
 		pd->lookup_pages = 0;
 		pd->loading = true;
 		mutex_unlock(&pd->lock);
@@ -622,8 +665,11 @@ int pvisor_lookup(struct inode *dir, struct dentry *entry,
 		pd->loading = false;
 		wake_up_all(&pd->wait);
 		fetched = true;
-		if (err)
+		if (err) {
+			if (miss_import)
+				pd->miss_windows = ARRAY_SIZE(miss_window_pages);
 			break;
+		}
 		found = pvisor_find(pd, &entry->d_name);
 		/* Grow only when the previous window contained demanded metadata. */
 		if (found && !found->lookup_only) {
