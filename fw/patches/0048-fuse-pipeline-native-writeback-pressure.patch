 static int fuse_send_open(struct fuse_mount *fm, u64 nodeid,
 			  unsigned int open_flags, int opcode,
 			  struct fuse_open_out *outargp, u64 *data_size)
 {
 	struct fuse_open_in inarg;
 	struct fuse_pvisor_open_out extended = {};
 	bool data_reply = fm->fc->pvisor_data_object && opcode == FUSE_OPEN;
 	int err;
 	FUSE_ARGS(args);
 
 	memset(&inarg, 0, sizeof(inarg));
 	inarg.flags = open_flags & ~(O_CREAT | O_EXCL | O_NOCTTY);
 	if (!fm->fc->atomic_o_trunc)
 		inarg.flags &= ~O_TRUNC;
 
 	if (fm->fc->handle_killpriv_v2 &&
 	    (inarg.flags & O_TRUNC) && !capable(CAP_FSETID)) {
 		inarg.open_flags |= FUSE_OPEN_KILL_SUIDGID;
 	}
 
 	args.opcode = opcode;
 	args.nodeid = nodeid;
 	args.in_numargs = 1;
 	args.in_args[0].size = sizeof(inarg);
 	args.in_args[0].value = &inarg;
 	args.out_numargs = 1;
 	args.out_args[0].size = data_reply ? sizeof(extended) : sizeof(*outargp);
 	args.out_args[0].value = data_reply ? (void *)&extended : outargp;
 
 	err = fuse_simple_request(fm, &args);
 	if (!err && data_reply) {
 		*outargp = extended.open;
 		*data_size = extended.size;
 	}
 	return err;
 }
 
 struct fuse_file *fuse_file_alloc(struct fuse_mount *fm, bool release)
 {
 	struct fuse_file *ff;
 
 	ff = kzalloc(sizeof(struct fuse_file), GFP_KERNEL_ACCOUNT);
 	if (unlikely(!ff))
 		return NULL;
 
 	ff->fm = fm;
 	if (release) {
 		ff->args = kzalloc(sizeof(*ff->args), GFP_KERNEL_ACCOUNT);
 		if (!ff->args) {
 			kfree(ff);
 			return NULL;
 		}
 	}
 
 	INIT_LIST_HEAD(&ff->write_entry);
 	INIT_LIST_HEAD(&ff->pvisor_entry);
 	INIT_LIST_HEAD(&ff->pvisor_wb_entry);
 	refcount_set(&ff->count, 1);
 	RB_CLEAR_NODE(&ff->polled_node);
 	init_waitqueue_head(&ff->poll_wait);
 
 	ff->kh = atomic64_inc_return(&fm->fc->khctr);
 
 	return ff;
 }
 
 void fuse_file_free(struct fuse_file *ff)
 {
 	kfree(ff->args);
 	kfree(ff);
 }
 
 static struct fuse_file *fuse_file_get(struct fuse_file *ff)
 {
 	refcount_inc(&ff->count);
 	return ff;
 }
 
