+static bool fuse_pvisor_wb_pressure(struct inode *inode)
+{
+	struct fuse_conn *fc = get_fuse_conn(inode);
+	struct bdi_writeback *wb = &inode_to_bdi(inode)->wb;
+	unsigned long limit = fc->pvisor_wb_pages;
+	u64 pages;
+
+	/* Both counters can underreport by wb_stat_error(). */
+	pages = wb_stat(wb, WB_RECLAIMABLE) + wb_stat(wb, WB_WRITEBACK);
+	if (pages + 2 * (u64)wb_stat_error() < limit)
+		return false;
+
+	/* FUSE charges temporary WRITE pages itself; do not count writes/bytes. */
+	pages = wb_stat_sum(wb, WB_RECLAIMABLE) +
+		wb_stat_sum(wb, WB_WRITEBACK);
+	return pages >= limit;
+}
+
+static void fuse_pvisor_wb_throttle(struct inode *inode)
+{
+	struct fuse_conn *fc = get_fuse_conn(inode);
+
+	while (!READ_ONCE(fc->pvisor_wb_error) && READ_ONCE(fc->connected) &&
+	       fuse_pvisor_wb_pressure(inode)) {
+		/* Also cover dirty mmap inodes that have no pending queue entry. */
+		wakeup_flusher_threads_bdi(inode_to_bdi(inode), WB_REASON_BACKGROUND);
+		/* Native WRITE completion does not need the producer's i_rwsem. */
+		wait_event_timeout(fc->pvisor_wb_wait,
+			READ_ONCE(fc->pvisor_wb_error) ||
+			!READ_ONCE(fc->connected) ||
+			!fuse_pvisor_wb_pressure(inode), PVISOR_WB_DELAY);
+	}
+}
