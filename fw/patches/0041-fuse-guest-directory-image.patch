diff --git a/fs/fuse/pvisor_meta.c b/fs/fuse/pvisor_meta.c
--- /dev/null
+++ b/fs/fuse/pvisor_meta.c
@@ -0,0 +1,843 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Directory image inside virtio-fs.
+ *
+ * The host publishes one merged directory page at a time. This cache answers
+ * lookup, readdir, and read-only open from that image. A name that is not in
+ * a finished image is absent. A missing page is one request of the negotiated
+ * FUSE budget, at most 1 MiB. File bytes and every stage change still go to
+ * the host. Rename drops the image and the next lookup uses the
+ * host, because exchanging two directories safely is the host overlay's job.
+ */
+
+#include "fuse_i.h"
+
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+
+#define PVISOR_MAX_ENTRIES 65536
+#define PVISOR_MAX_PAGES 32
+#define PVISOR_VALID_SEC 86400ULL
+/* Matches FUSE_MAX_MAX_PAGES and the host's 1 MiB request buffer. */
+#define PVISOR_MAX_TRANSFER_PAGES 256U
+
+struct pvisor_entry {
+	struct rb_node node;
+	struct list_head list;
+	u64 nodeid;
+	u64 generation;
+	u64 cookie;
+	u64 ino;
+	u32 type;
+	u32 namelen;
+	bool whiteout;
+	bool local;
+	bool accounted;
+	bool lookup_only;
+	struct fuse_attr attr;
+	char name[];
+};
+
+struct pvisor_dir {
+	struct mutex lock;
+	wait_queue_head_t wait;
+	struct rb_root names;
+	struct list_head order;
+	u64 next_offset;
+	u64 max_cookie;
+	u32 count;
+	bool complete;
+	bool passthrough;
+	bool loading;
+};
+
+static struct pvisor_entry *pvisor_find(struct pvisor_dir *pd,
+					const struct qstr *name)
+{
+	struct rb_node *node = pd->names.rb_node;
+
+	while (node) {
+		struct pvisor_entry *entry =
+			rb_entry(node, struct pvisor_entry, node);
+		int cmp = memcmp(name->name, entry->name,
+				 min_t(unsigned int, name->len, entry->namelen));
+
+		if (!cmp && name->len != entry->namelen)
+			cmp = name->len < entry->namelen ? -1 : 1;
+		if (cmp < 0)
+			node = node->rb_left;
+		else if (cmp > 0)
+			node = node->rb_right;
+		else
+			return entry;
+	}
+	return NULL;
+}
+
+static void pvisor_forget_one(struct fuse_mount *fm, u64 nodeid)
+{
+	struct fuse_forget_link *forget;
+
+	if (!nodeid)
+		return;
+	forget = fuse_alloc_forget();
+	if (!forget)
+		return;
+	fuse_queue_forget(fm->fc, forget, nodeid, 1);
+}
+
+static void pvisor_free_entry(struct pvisor_entry *entry)
+{
+	kfree(entry);
+}
+
+static void pvisor_clear(struct fuse_mount *fm, struct pvisor_dir *pd)
+{
+	struct pvisor_entry *entry, *next;
+
+	list_for_each_entry_safe(entry, next, &pd->order, list) {
+		rb_erase(&entry->node, &pd->names);
+		list_del(&entry->list);
+		if (!entry->accounted)
+			pvisor_forget_one(fm, entry->nodeid);
+		pvisor_free_entry(entry);
+	}
+	pd->count = 0;
+	pd->complete = false;
+	pd->next_offset = 0;
+	pd->max_cookie = 0;
+}
+
+static struct pvisor_dir *pvisor_prepare(struct inode *dir)
+{
+	struct fuse_inode *fi = get_fuse_inode(dir);
+	struct pvisor_dir *created = NULL;
+	struct pvisor_dir *pd;
+
+	if (!S_ISDIR(dir->i_mode))
+		return NULL;
+	spin_lock(&fi->lock);
+	pd = fi->pvisor;
+	spin_unlock(&fi->lock);
+	if (pd)
+		return pd;
+
+	created = kzalloc(sizeof(*created), GFP_KERNEL);
+	if (!created)
+		return ERR_PTR(-ENOMEM);
+	mutex_init(&created->lock);
+	init_waitqueue_head(&created->wait);
+	created->names = RB_ROOT;
+	INIT_LIST_HEAD(&created->order);
+
+	spin_lock(&fi->lock);
+	if (fi->pvisor) {
+		pd = fi->pvisor;
+	} else {
+		fi->pvisor = created;
+		pd = created;
+		created = NULL;
+	}
+	spin_unlock(&fi->lock);
+	if (created) {
+		mutex_destroy(&created->lock);
+		kfree(created);
+	}
+	return pd;
+}
+
+static void pvisor_negative(struct fuse_entry_out *outarg)
+{
+	memset(outarg, 0, sizeof(*outarg));
+	outarg->entry_valid = PVISOR_VALID_SEC;
+}
+
+static int pvisor_insert(struct pvisor_dir *pd, struct pvisor_entry *entry)
+{
+	struct rb_node **link = &pd->names.rb_node;
+	struct rb_node *parent = NULL;
+
+	while (*link) {
+		struct pvisor_entry *here =
+			rb_entry(*link, struct pvisor_entry, node);
+		int cmp = memcmp(entry->name, here->name,
+				 min_t(u32, entry->namelen, here->namelen));
+
+		parent = *link;
+		if (!cmp && entry->namelen != here->namelen)
+			cmp = entry->namelen < here->namelen ? -1 : 1;
+		if (cmp < 0)
+			link = &(*link)->rb_left;
+		else if (cmp > 0)
+			link = &(*link)->rb_right;
+		else
+			return -EEXIST;
+	}
+	rb_link_node(&entry->node, parent, link);
+	rb_insert_color(&entry->node, &pd->names);
+	list_add_tail(&entry->list, &pd->order);
+	pd->count++;
+	if (entry->cookie > pd->max_cookie)
+		pd->max_cookie = entry->cookie;
+	return 0;
+}
+
+static struct pvisor_entry *pvisor_make(const char *name, u32 namelen)
+{
+	struct pvisor_entry *entry;
+
+	if (!namelen || namelen > FUSE_NAME_MAX)
+		return ERR_PTR(-EIO);
+	entry = kzalloc(struct_size(entry, name, namelen), GFP_KERNEL);
+	if (!entry)
+		return ERR_PTR(-ENOMEM);
+	entry->namelen = namelen;
+	memcpy(entry->name, name, namelen);
+	return entry;
+}
+
+static void pvisor_wait_load(struct pvisor_dir *pd)
+{
+	DEFINE_WAIT(wait);
+
+	while (pd->loading) {
+		prepare_to_wait(&pd->wait, &wait, TASK_UNINTERRUPTIBLE);
+		if (!pd->loading)
+			break;
+		mutex_unlock(&pd->lock);
+		schedule();
+		mutex_lock(&pd->lock);
+	}
+	finish_wait(&pd->wait, &wait);
+}
+
+static int pvisor_link(struct dentry *parent, struct fuse_direntplus *direntplus,
+		       u64 attr_version)
+{
+	struct fuse_entry_out *out = &direntplus->entry_out;
+	struct fuse_dirent *dirent = &direntplus->dirent;
+	struct qstr name = QSTR_INIT(dirent->name, dirent->namelen);
+	struct dentry *dentry;
+	struct inode *inode;
+
+	if (!out->nodeid)
+		return 0;
+	if (name.name[0] == '.' &&
+	    (name.len == 1 || (name.len == 2 && name.name[1] == '.')))
+		return 0;
+	if (invalid_nodeid(out->nodeid) || fuse_invalid_attr(&out->attr))
+		return -EIO;
+
+	name.hash = full_name_hash(parent, name.name, name.len);
+	dentry = d_lookup(parent, &name);
+	if (dentry) {
+		if (d_in_lookup(dentry)) {
+			dput(dentry);
+			return 1;
+		}
+		inode = d_inode(dentry);
+		if (inode && get_node_id(inode) == out->nodeid &&
+		    !fuse_stale_inode(inode, (int)out->generation, &out->attr)) {
+			struct fuse_inode *fi = get_fuse_inode(inode);
+
+			spin_lock(&fi->lock);
+			fi->nlookup++;
+			spin_unlock(&fi->lock);
+			fuse_change_attributes(inode, &out->attr, NULL,
+					       ATTR_TIMEOUT(out), attr_version);
+			fuse_change_entry_timeout(dentry, out);
+			dput(dentry);
+			return 0;
+		}
+		dput(dentry);
+	}
+
+	dentry = d_alloc(parent, &name);
+	if (!dentry)
+		return -ENOMEM;
+	inode = fuse_iget(d_inode(parent)->i_sb, out->nodeid,
+			  (int)out->generation, &out->attr, ATTR_TIMEOUT(out),
+			  attr_version);
+	if (!inode) {
+		dput(dentry);
+		return -ENOMEM;
+	}
+	d_add(dentry, inode);
+	fuse_change_entry_timeout(dentry, out);
+	dput(dentry);
+	return 0;
+}
+
+static void pvisor_drain(struct fuse_mount *fm, void *body, size_t len)
+{
+	while (len >= FUSE_NAME_OFFSET_DIRENTPLUS) {
+		struct fuse_direntplus *direntplus = body;
+		struct fuse_dirent *dirent = &direntplus->dirent;
+		size_t reclen;
+
+		if (!dirent->namelen || dirent->namelen > FUSE_NAME_MAX)
+			return;
+		reclen = FUSE_DIRENTPLUS_SIZE(direntplus);
+		if (reclen > len || memchr(dirent->name, '/', dirent->namelen))
+			return;
+		pvisor_forget_one(fm, direntplus->entry_out.nodeid);
+		body += reclen;
+		len -= reclen;
+	}
+}
+
+static void pvisor_mark(struct pvisor_dir *pd, const struct qstr *name)
+{
+	struct pvisor_entry *entry;
+
+	mutex_lock(&pd->lock);
+	entry = pvisor_find(pd, name);
+	if (entry)
+		entry->accounted = true;
+	mutex_unlock(&pd->lock);
+}
+
+static void pvisor_erase(struct pvisor_dir *pd, const struct qstr *name)
+{
+	struct pvisor_entry *entry;
+
+	mutex_lock(&pd->lock);
+	entry = pvisor_find(pd, name);
+	if (entry) {
+		rb_erase(&entry->node, &pd->names);
+		list_del(&entry->list);
+		pd->count--;
+		entry->accounted = true;
+		pvisor_free_entry(entry);
+	}
+	mutex_unlock(&pd->lock);
+}
+
+static int pvisor_publish_page(struct inode *dir, struct dentry *parent,
+			       const struct qstr *skip, void *body, size_t len,
+			       bool complete, u64 next_offset)
+{
+	struct fuse_mount *fm = get_fuse_mount(dir);
+	struct pvisor_dir *pd = get_fuse_inode(dir)->pvisor;
+	bool have_skip = false;
+	u64 attr_version = fuse_get_attr_version(fm->fc);
+	int err = 0;
+
+	while (len >= FUSE_NAME_OFFSET_DIRENTPLUS) {
+		struct fuse_direntplus *direntplus = body;
+		struct fuse_dirent *dirent = &direntplus->dirent;
+		size_t reclen = FUSE_DIRENTPLUS_SIZE(direntplus);
+		struct qstr name = QSTR_INIT(dirent->name, dirent->namelen);
+		struct pvisor_entry *entry, *existing;
+		bool active, lookup_only;
+
+		if (!dirent->namelen || dirent->namelen > FUSE_NAME_MAX ||
+		    reclen > len ||
+		    memchr(dirent->name, '/', dirent->namelen))
+			return -EIO;
+		body += reclen;
+		len -= reclen;
+		active = skip && skip->len == name.len &&
+			 !memcmp(skip->name, name.name, name.len);
+		entry = pvisor_make(dirent->name, dirent->namelen);
+		if (IS_ERR(entry)) {
+			pvisor_forget_one(fm, direntplus->entry_out.nodeid);
+			pvisor_drain(fm, body, len);
+			return PTR_ERR(entry);
+		}
+		entry->nodeid = direntplus->entry_out.nodeid;
+		entry->generation = direntplus->entry_out.generation;
+		entry->cookie = dirent->off;
+		entry->ino = dirent->ino;
+		entry->type = dirent->type;
+		entry->attr = direntplus->entry_out.attr;
+		lookup_only = !direntplus->entry_out.entry_valid &&
+			      !direntplus->entry_out.entry_valid_nsec;
+		entry->lookup_only = lookup_only;
+
+		mutex_lock(&pd->lock);
+		if (pd->passthrough || pd->count >= PVISOR_MAX_ENTRIES) {
+			pd->passthrough = true;
+			pvisor_clear(fm, pd);
+			mutex_unlock(&pd->lock);
+			pvisor_free_entry(entry);
+			pvisor_forget_one(fm, direntplus->entry_out.nodeid);
+			have_skip = false;
+			err = -EAGAIN;
+			continue;
+		}
+		existing = pvisor_find(pd, &name);
+		if (existing) {
+			bool pending = active && !existing->accounted;
+
+			mutex_unlock(&pd->lock);
+			pvisor_free_entry(entry);
+			if (pending)
+				have_skip = true;
+			else
+				pvisor_forget_one(fm, direntplus->entry_out.nodeid);
+			continue;
+		}
+		if (pvisor_insert(pd, entry)) {
+			mutex_unlock(&pd->lock);
+			pvisor_free_entry(entry);
+			pvisor_forget_one(fm, direntplus->entry_out.nodeid);
+			pvisor_drain(fm, body, len);
+			return -EIO;
+		}
+		mutex_unlock(&pd->lock);
+
+		/* One-shot names must be consumed by the host LOOKUP. */
+		if (lookup_only) {
+			pvisor_forget_one(fm, direntplus->entry_out.nodeid);
+			pvisor_mark(pd, &name);
+			continue;
+		}
+
+		if (active) {
+			have_skip = true;
+			continue;
+		}
+		if (!direntplus->entry_out.nodeid) {
+			pvisor_mark(pd, &name);
+			continue;
+		}
+		name.hash = full_name_hash(parent, name.name, name.len);
+		err = pvisor_link(parent, direntplus, attr_version);
+		if (err > 0) {
+			pvisor_forget_one(fm, direntplus->entry_out.nodeid);
+			pvisor_mark(pd, &name);
+			err = 0;
+			continue;
+		}
+		if (err) {
+			pvisor_forget_one(fm, direntplus->entry_out.nodeid);
+			pvisor_erase(pd, &name);
+			pvisor_drain(fm, body, len);
+			return err;
+		}
+		pvisor_mark(pd, &name);
+	}
+	if (len)
+		return -EIO;
+
+	mutex_lock(&pd->lock);
+	if (!err && !pd->passthrough) {
+		pd->next_offset = next_offset;
+		if (complete)
+			pd->complete = true;
+	}
+	mutex_unlock(&pd->lock);
+	if (err)
+		return err;
+	if (have_skip && skip)
+		return 1;
+	return 0;
+}
+
+static unsigned int pvisor_transfer_bytes(struct fuse_conn *fc)
+{
+	unsigned int pages = fc->max_pages;
+
+	if (pages < 1)
+		pages = 1;
+	if (pages > PVISOR_MAX_TRANSFER_PAGES)
+		pages = PVISOR_MAX_TRANSFER_PAGES;
+	return pages << PAGE_SHIFT;
+}
+
+static void pvisor_free_pages(struct page **pages, unsigned int npages,
+			      struct fuse_page_desc *descs)
+{
+	unsigned int i;
+
+	if (pages) {
+		for (i = 0; i < npages; i++) {
+			if (pages[i])
+				__free_page(pages[i]);
+		}
+		kvfree(pages);
+	}
+	kvfree(descs);
+}
+
+static int pvisor_fetch(struct inode *dir, struct dentry *parent,
+			const struct qstr *skip, struct fuse_entry_out *skipped)
+{
+	struct fuse_mount *fm = get_fuse_mount(dir);
+	struct pvisor_dir *pd = get_fuse_inode(dir)->pvisor;
+	struct fuse_read_in inarg;
+	struct fuse_args_pages ap = {};
+	struct fuse_readindex_out *hdr;
+	struct page **pages = NULL;
+	struct fuse_page_desc *descs = NULL;
+	unsigned int budget, npages, i;
+	void *mapped = NULL;
+	u64 offset;
+	ssize_t res;
+	bool complete;
+	int err;
+
+	mutex_lock(&pd->lock);
+	offset = pd->next_offset;
+	mutex_unlock(&pd->lock);
+
+	budget = pvisor_transfer_bytes(fm->fc);
+	npages = budget >> PAGE_SHIFT;
+	pages = kvmalloc_array(npages, sizeof(*pages), GFP_KERNEL | __GFP_ZERO);
+	descs = kvmalloc_array(npages, sizeof(*descs), GFP_KERNEL);
+	if (!pages || !descs) {
+		err = -ENOMEM;
+		goto out;
+	}
+	for (i = 0; i < npages; i++) {
+		pages[i] = alloc_page(GFP_KERNEL | __GFP_ZERO);
+		if (!pages[i]) {
+			err = -ENOMEM;
+			goto out;
+		}
+		descs[i].length = PAGE_SIZE;
+		descs[i].offset = 0;
+	}
+	memset(&inarg, 0, sizeof(inarg));
+	inarg.offset = offset;
+	inarg.size = budget;
+	ap.args.opcode = FUSE_READINDEX;
+	ap.args.nodeid = get_node_id(dir);
+	ap.args.in_numargs = 1;
+	ap.args.in_args[0].size = sizeof(inarg);
+	ap.args.in_args[0].value = &inarg;
+	ap.args.out_numargs = 1;
+	ap.args.out_args[0].size = budget;
+	ap.args.out_pages = true;
+	ap.args.out_argvar = true;
+	ap.args.page_zeroing = true;
+	ap.pages = pages;
+	ap.descs = descs;
+	ap.num_pages = npages;
+	/*
+	 * out_argvar makes fuse_simple_request return the byte count. Without
+	 * it a successful reply returns 0 and the image would treat that as
+	 * a short read.
+	 */
+	res = fuse_simple_request(fm, &ap.args);
+	if (res < 0) {
+		err = res;
+		if (err == -ENOSYS) {
+			mutex_lock(&pd->lock);
+			pd->passthrough = true;
+			pvisor_clear(fm, pd);
+			mutex_unlock(&pd->lock);
+			err = -EAGAIN;
+		}
+		goto out;
+	}
+	if (res < (ssize_t)sizeof(struct fuse_readindex_out) || res > budget) {
+		err = -EIO;
+		goto out;
+	}
+	mapped = vmap(pages, npages, VM_MAP, PAGE_KERNEL);
+	if (!mapped) {
+		err = -ENOMEM;
+		goto out;
+	}
+	hdr = mapped;
+	complete = hdr->flags & FUSE_READINDEX_COMPLETE;
+	if (!complete && hdr->next_offset <= offset) {
+		err = -EIO;
+		goto out;
+	}
+	err = pvisor_publish_page(dir, parent, skip,
+				  (char *)mapped + sizeof(*hdr),
+				  res - sizeof(*hdr), complete,
+				  hdr->next_offset);
+	if (err == 1 && skipped) {
+		struct pvisor_entry *entry;
+		struct qstr name = *skip;
+
+		mutex_lock(&pd->lock);
+		entry = pvisor_find(pd, &name);
+		if (entry && !entry->whiteout) {
+			skipped->nodeid = entry->nodeid;
+			skipped->generation = entry->generation;
+			skipped->entry_valid = PVISOR_VALID_SEC;
+			skipped->attr_valid = PVISOR_VALID_SEC;
+			skipped->entry_valid_nsec = 0;
+			skipped->attr_valid_nsec = 0;
+			skipped->attr = entry->attr;
+			err = 0;
+		} else if (pd->passthrough) {
+			err = -EAGAIN;
+		} else {
+			err = -EIO;
+		}
+		mutex_unlock(&pd->lock);
+	}
+out:
+	if (mapped)
+		vunmap(mapped);
+	pvisor_free_pages(pages, npages, descs);
+	return err;
+}
+int pvisor_lookup(struct inode *dir, struct dentry *entry,
+		  struct fuse_entry_out *outarg, struct inode **inode)
+{
+	struct pvisor_dir *pd;
+	struct pvisor_entry *found;
+	int pages = 0;
+	int err = -EAGAIN;
+
+	*inode = NULL;
+	if (!get_fuse_conn(dir)->pvisor_meta)
+		return -EAGAIN;
+	pd = pvisor_prepare(dir);
+	if (IS_ERR(pd))
+		return PTR_ERR(pd);
+	if (!pd)
+		return -EAGAIN;
+
+	mutex_lock(&pd->lock);
+	for (;;) {
+		if (pd->passthrough) {
+			err = -EAGAIN;
+			break;
+		}
+		found = pvisor_find(pd, &entry->d_name);
+		if (found && found->lookup_only) {
+			err = -EAGAIN;
+			break;
+		}
+		if (found && found->whiteout) {
+			pvisor_negative(outarg);
+			err = 0;
+			break;
+		}
+		if (found && !found->whiteout) {
+			if (!found->nodeid) {
+				pvisor_negative(outarg);
+				err = 0;
+				break;
+			}
+			if (found->accounted) {
+				err = -EAGAIN;
+				break;
+			}
+			outarg->nodeid = found->nodeid;
+			outarg->generation = found->generation;
+			outarg->entry_valid = PVISOR_VALID_SEC;
+			outarg->attr_valid = PVISOR_VALID_SEC;
+			outarg->attr = found->attr;
+			found->accounted = true;
+			*inode = fuse_iget(dir->i_sb, outarg->nodeid,
+					   (int)outarg->generation, &outarg->attr,
+					   ATTR_TIMEOUT(outarg),
+					   fuse_get_attr_version(get_fuse_conn(dir)));
+			if (!*inode) {
+				pvisor_forget_one(get_fuse_mount(dir), outarg->nodeid);
+				err = -ENOMEM;
+			} else {
+				err = 0;
+			}
+			break;
+		}
+		if (pd->complete) {
+			pvisor_negative(outarg);
+			err = 0;
+			break;
+		}
+		if (pages >= PVISOR_MAX_PAGES) {
+			err = -EAGAIN;
+			break;
+		}
+		pvisor_wait_load(pd);
+		if (pd->loading)
+			continue;
+		pd->loading = true;
+		mutex_unlock(&pd->lock);
+		memset(outarg, 0, sizeof(*outarg));
+		err = pvisor_fetch(dir, entry->d_parent, &entry->d_name, outarg);
+		mutex_lock(&pd->lock);
+		pd->loading = false;
+		wake_up_all(&pd->wait);
+		pages++;
+		if (!err && outarg->nodeid) {
+			*inode = fuse_iget(dir->i_sb, outarg->nodeid,
+					   (int)outarg->generation, &outarg->attr,
+					   ATTR_TIMEOUT(outarg),
+					   fuse_get_attr_version(get_fuse_conn(dir)));
+			if (!*inode) {
+				pvisor_forget_one(get_fuse_mount(dir), outarg->nodeid);
+				found = pvisor_find(pd, &entry->d_name);
+				if (found)
+					found->accounted = true;
+				err = -ENOMEM;
+			} else {
+				found = pvisor_find(pd, &entry->d_name);
+				if (found) {
+					found->accounted = true;
+				}
+			}
+			break;
+		}
+		if (err)
+			break;
+	}
+	mutex_unlock(&pd->lock);
+	return err;
+}
+
+static void pvisor_note(struct inode *dir, const struct qstr *name,
+			struct fuse_entry_out *outarg, bool whiteout)
+{
+	struct fuse_inode *fi = get_fuse_inode(dir);
+	struct pvisor_dir *pd;
+	struct pvisor_entry *entry;
+
+	if (!get_fuse_conn(dir)->pvisor_meta)
+		return;
+	spin_lock(&fi->lock);
+	pd = fi->pvisor;
+	spin_unlock(&fi->lock);
+	if (!pd)
+		return;
+	mutex_lock(&pd->lock);
+	if (pd->passthrough) {
+		mutex_unlock(&pd->lock);
+		return;
+	}
+	entry = pvisor_find(pd, name);
+	if (!entry) {
+		entry = pvisor_make(name->name, name->len);
+		if (IS_ERR(entry)) {
+			pd->passthrough = true;
+			pvisor_clear(get_fuse_mount(dir), pd);
+			mutex_unlock(&pd->lock);
+			return;
+		}
+		entry->cookie = pd->max_cookie + 1;
+		if (pvisor_insert(pd, entry)) {
+			pvisor_free_entry(entry);
+			pd->passthrough = true;
+			pvisor_clear(get_fuse_mount(dir), pd);
+			mutex_unlock(&pd->lock);
+			return;
+		}
+	}
+	entry->local = true;
+	entry->accounted = true;
+	entry->whiteout = whiteout;
+	if (!whiteout && outarg) {
+		entry->nodeid = outarg->nodeid;
+		entry->generation = outarg->generation;
+		entry->ino = outarg->attr.ino;
+		entry->attr = outarg->attr;
+		entry->type = (outarg->attr.mode & S_IFMT) >> 12;
+	}
+	mutex_unlock(&pd->lock);
+}
+
+void pvisor_note_create(struct inode *dir, const struct qstr *name,
+			struct fuse_entry_out *outarg)
+{
+	pvisor_note(dir, name, outarg, false);
+}
+
+void pvisor_note_unlink(struct inode *dir, const struct qstr *name)
+{
+	pvisor_note(dir, name, NULL, true);
+}
+
+static void pvisor_poison(struct inode *dir)
+{
+	struct fuse_inode *fi = get_fuse_inode(dir);
+	struct pvisor_dir *pd;
+
+	spin_lock(&fi->lock);
+	pd = fi->pvisor;
+	spin_unlock(&fi->lock);
+	if (!pd)
+		return;
+	mutex_lock(&pd->lock);
+	pd->passthrough = true;
+	pvisor_clear(get_fuse_mount(dir), pd);
+	mutex_unlock(&pd->lock);
+}
+
+void pvisor_note_rename(struct inode *olddir, struct inode *newdir)
+{
+	if (!get_fuse_conn(olddir)->pvisor_meta)
+		return;
+	pvisor_poison(olddir);
+	if (olddir != newdir)
+		pvisor_poison(newdir);
+}
+
+int pvisor_readdir(struct file *file, struct dir_context *ctx)
+{
+	struct inode *inode = file_inode(file);
+	struct pvisor_dir *pd;
+	struct pvisor_entry *entry;
+	int pages = 0;
+	int err = 0;
+
+	if (!get_fuse_conn(inode)->pvisor_meta)
+		return -EAGAIN;
+	pd = pvisor_prepare(inode);
+	if (IS_ERR(pd))
+		return PTR_ERR(pd);
+	if (!pd)
+		return -EAGAIN;
+
+	mutex_lock(&pd->lock);
+	while (!pd->complete && !pd->passthrough && pages < PVISOR_MAX_PAGES) {
+		pvisor_wait_load(pd);
+		if (pd->complete || pd->passthrough)
+			break;
+		if (pd->loading)
+			continue;
+		pd->loading = true;
+		mutex_unlock(&pd->lock);
+		err = pvisor_fetch(inode, file->f_path.dentry, NULL, NULL);
+		mutex_lock(&pd->lock);
+		pd->loading = false;
+		wake_up_all(&pd->wait);
+		pages++;
+		if (err == -EAGAIN) {
+			pd->passthrough = true;
+			break;
+		}
+		if (err)
+			break;
+	}
+	if (err || pd->passthrough || !pd->complete) {
+		mutex_unlock(&pd->lock);
+		return err ? err : -EAGAIN;
+	}
+	list_for_each_entry(entry, &pd->order, list) {
+		if (entry->lookup_only || entry->whiteout || entry->cookie <= ctx->pos)
+			continue;
+		if (!dir_emit(ctx, entry->name, entry->namelen, entry->ino,
+			      entry->type))
+			break;
+		ctx->pos = entry->cookie;
+	}
+	mutex_unlock(&pd->lock);
+	return 0;
+}
+
+void pvisor_evict(struct inode *inode)
+{
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	struct pvisor_dir *pd;
+
+	spin_lock(&fi->lock);
+	pd = fi->pvisor;
+	fi->pvisor = NULL;
+	spin_unlock(&fi->lock);
+	if (!pd)
+		return;
+	pvisor_clear(get_fuse_mount(inode), pd);
+	mutex_destroy(&pd->lock);
+	kfree(pd);
+}
