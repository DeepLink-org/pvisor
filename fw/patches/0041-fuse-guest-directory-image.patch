+/* The inode's deferred-open lock also keeps release from publishing fh=0. */
+static int fuse_pvisor_bind_locked(struct inode *inode, struct fuse_file *ff,
+                                  unsigned int flags)
+{
+	const struct cred *saved;
+	struct fuse_open_out outarg;
+	int opcode, err;
+
+	if (!ff->pvisor_unbound)
+		return 0;
+	opcode = S_ISDIR(inode->i_mode) ? FUSE_OPENDIR : FUSE_OPEN;
+	saved = ff->pvisor_cred ? override_creds(ff->pvisor_cred) : NULL;
+	err = fuse_send_open(ff->fm, ff->nodeid, flags, opcode, &outarg);
+	if (saved)
+		revert_creds(saved);
+	if (err)
+		return err;
+
+	ff->fh = outarg.fh;
+	ff->open_flags = outarg.open_flags;
+	if (S_ISREG(inode->i_mode) && !(outarg.open_flags & FOPEN_KEEP_CACHE))
+		invalidate_inode_pages2(inode->i_mapping);
+	list_del_init(&ff->pvisor_entry);
+	if (ff->pvisor_cred) {
+		put_cred(ff->pvisor_cred);
+		ff->pvisor_cred = NULL;
+	}
+	smp_store_release(&ff->pvisor_unbound, false);
+	return 0;
+}
+
+int fuse_pvisor_bind(struct file *file)
+{
+	struct fuse_file *ff = file->private_data;
+	struct inode *inode = file_inode(file);
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	int err;
+
+	if (!ff || !smp_load_acquire(&ff->pvisor_unbound))
+		return 0;
+	mutex_lock(&fi->pvisor_open_lock);
+	err = fuse_pvisor_bind_locked(inode, ff, file->f_flags);
+	mutex_unlock(&fi->pvisor_open_lock);
+	return err;
+}
+
+/* Pin host objects before unlink, replacement, or permission changes. */
+int fuse_pvisor_bind_pending(struct inode *inode)
+{
+	struct fuse_inode *fi;
+	struct fuse_file *ff;
+	int err = 0;
+
+	if (!inode || !S_ISREG(inode->i_mode) || !get_fuse_conn(inode)->pvisor_meta)
+		return 0;
+	fi = get_fuse_inode(inode);
+	mutex_lock(&fi->pvisor_open_lock);
+	while (!list_empty(&fi->pvisor_opens)) {
+		ff = list_first_entry(&fi->pvisor_opens, struct fuse_file, pvisor_entry);
+		err = fuse_pvisor_bind_locked(inode, ff, ff->pvisor_flags);
+		if (err)
+			break;
+	}
+	mutex_unlock(&fi->pvisor_open_lock);
+	return err;
+}
