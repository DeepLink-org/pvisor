+/* The queue holds existing cache pages through inode/handle references. */
+#define PVISOR_WB_THRESHOLD (1U << 20)
+#define PVISOR_WB_HIGH_WATER (16U << 20)
+#define PVISOR_WB_MAX_FILES 256U
+#define PVISOR_WB_DELAY msecs_to_jiffies(10)
+
+static bool fuse_pvisor_wb_enabled(struct inode *inode, struct fuse_file *ff)
+{
+	struct fuse_conn *fc = ff->fm->fc;
+
+	return fc->pvisor_wb_wq && S_ISREG(inode->i_mode) &&
+		!FUSE_IS_DAX(inode) && !(ff->open_flags & FOPEN_DIRECT_IO);
+}
+
+static void fuse_pvisor_wb_error(struct fuse_conn *fc, int error)
+{
+	if (error < 0 && !cmpxchg(&fc->pvisor_wb_error, 0, error))
+		pr_err("fuse-pvisor-wb: error=%d caller=%pS\n", error,
+		       __builtin_return_address(0));
+}
+
+static bool fuse_pvisor_wb_queue(struct inode *inode, struct fuse_file *ff,
+			       u64 bytes, bool released, unsigned int flags)
+{
+	struct fuse_conn *fc = ff->fm->fc;
+	bool full;
+
+retry:
+	spin_lock(&fc->pvisor_wb_lock);
+	if (!ff->pvisor_wb_queued && fc->pvisor_wb_count >= PVISOR_WB_MAX_FILES) {
+		mod_delayed_work(fc->pvisor_wb_wq, &fc->pvisor_wb_work, 0);
+		spin_unlock(&fc->pvisor_wb_lock);
+		wait_event(fc->pvisor_wb_wait,
+			   READ_ONCE(fc->pvisor_wb_count) < PVISOR_WB_MAX_FILES);
+		goto retry;
+	}
+	if (!ff->pvisor_wb_queued) {
+		ihold(inode);
+		fuse_file_get(ff);
+		ff->pvisor_wb_inode = inode;
+		ff->pvisor_wb_queued = true;
+		list_add_tail(&ff->pvisor_wb_entry, &fc->pvisor_wb_pending);
+		fc->pvisor_wb_count++;
+	}
+	ff->pvisor_wb_bytes += bytes;
+	fc->pvisor_wb_bytes += bytes;
+	if (released) {
+		ff->pvisor_wb_released = true;
+		ff->pvisor_wb_flags = flags;
+	}
+	if (fc->pvisor_wb_bytes >= PVISOR_WB_THRESHOLD ||
+	    fc->pvisor_wb_count >= PVISOR_WB_MAX_FILES)
+		mod_delayed_work(fc->pvisor_wb_wq, &fc->pvisor_wb_work, 0);
+	else
+		queue_delayed_work(fc->pvisor_wb_wq, &fc->pvisor_wb_work,
+				   PVISOR_WB_DELAY);
+	full = fc->pvisor_wb_bytes >= PVISOR_WB_HIGH_WATER;
+	spin_unlock(&fc->pvisor_wb_lock);
+	if (full)
+		wait_event(fc->pvisor_wb_wait,
+			   READ_ONCE(fc->pvisor_wb_bytes) < PVISOR_WB_HIGH_WATER);
+	return true;
+}
+
+static int fuse_pvisor_wb_flush(struct inode *inode, struct fuse_file *ff)
+{
+	struct fuse_mount *fm = ff->fm;
+	struct fuse_flush_in inarg = { .fh = ff->fh };
+	FUSE_ARGS(args);
+	int err;
+
+	if (fm->fc->no_flush)
+		return 0;
+	/* No remote locks are negotiated; the authorized OPEN pins this fh. */
+	args.opcode = FUSE_FLUSH;
+	args.nodeid = get_node_id(inode);
+	args.in_numargs = 1;
+	args.in_args[0].size = sizeof(inarg);
+	args.in_args[0].value = &inarg;
+	args.force = true;
+	args.nocreds = true;
+	err = fuse_simple_request(fm, &args);
+	if (err == -ENOSYS) {
+		fm->fc->no_flush = 1;
+		err = 0;
+	}
+	return err;
+}
+
+static void fuse_pvisor_wb_work(struct work_struct *work)
+{
+	struct fuse_conn *fc = container_of(to_delayed_work(work),
+					   struct fuse_conn, pvisor_wb_work);
+	struct fuse_file *ff, *next;
+	LIST_HEAD(batch);
+
+	spin_lock(&fc->pvisor_wb_lock);
+	list_splice_init(&fc->pvisor_wb_pending, &batch);
+	list_for_each_entry(ff, &batch, pvisor_wb_entry) {
+		ff->pvisor_wb_submitted = ff->pvisor_wb_bytes;
+		ff->pvisor_wb_bytes = 0;
+	}
+	spin_unlock(&fc->pvisor_wb_lock);
+
+	/* Submit the entire batch before waiting for any host completion. */
+	list_for_each_entry(ff, &batch, pvisor_wb_entry)
+		fuse_pvisor_wb_error(fc,
+			filemap_fdatawrite(ff->pvisor_wb_inode->i_mapping));
+
+	list_for_each_entry_safe(ff, next, &batch, pvisor_wb_entry) {
+		struct inode *inode = ff->pvisor_wb_inode;
+		bool released;
+
+		fuse_pvisor_wb_error(fc, write_inode_now(inode, 1));
+		inode_lock(inode);
+		fuse_sync_writes(inode);
+		inode_unlock(inode);
+		fuse_pvisor_wb_error(fc, filemap_check_errors(inode->i_mapping));
+
+		spin_lock(&fc->pvisor_wb_lock);
+		list_del_init(&ff->pvisor_wb_entry);
+		fc->pvisor_wb_bytes -= ff->pvisor_wb_submitted;
+		ff->pvisor_wb_submitted = 0;
+		if (ff->pvisor_wb_bytes) {
+			list_add_tail(&ff->pvisor_wb_entry, &fc->pvisor_wb_pending);
+			spin_unlock(&fc->pvisor_wb_lock);
+			wake_up_all(&fc->pvisor_wb_wait);
+			continue;
+		}
+		released = ff->pvisor_wb_released;
+		ff->pvisor_wb_queued = false;
+		ff->pvisor_wb_inode = NULL;
+		fc->pvisor_wb_count--;
+		spin_unlock(&fc->pvisor_wb_lock);
+		if (released) {
+			fuse_pvisor_wb_error(fc, fuse_pvisor_wb_flush(inode, ff));
+			fuse_file_release(inode, ff, ff->pvisor_wb_flags, 0, false);
+		}
+		fuse_file_put(ff, false);
+		iput(inode);
+		wake_up_all(&fc->pvisor_wb_wait);
+	}
+}
+
+int fuse_pvisor_wb_enable(struct fuse_conn *fc)
+{
+	INIT_DELAYED_WORK(&fc->pvisor_wb_work, fuse_pvisor_wb_work);
+	fc->pvisor_wb_wq = alloc_workqueue("fuse-pvisor-wb",
+					 WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	return fc->pvisor_wb_wq ? 0 : -ENOMEM;
+}
+
+int fuse_pvisor_wb_drain(struct fuse_conn *fc)
+{
+	if (fc->pvisor_wb_wq) {
+		do {
+			flush_delayed_work(&fc->pvisor_wb_work);
+		} while (READ_ONCE(fc->pvisor_wb_count));
+	}
+	return READ_ONCE(fc->pvisor_wb_error);
+}
+
