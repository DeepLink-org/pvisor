From: pVisor <pvisor@local>
Subject: fuse: fill READINDEX and sequential READ up to 1 MiB

A directory import asked for one 4 KiB page, and sequential reads kept
the 128 KiB readahead default. Request the negotiated FUSE page budget,
at most 256 pages, and raise readahead to that budget. The directory
reply is carried in pages so virtio-fs does not kmalloc the whole buffer
with GFP_ATOMIC. out_argvar is required: fuse_simple_request returns the
byte count only for a variable-sized reply.

diff -ruN a/fs/fuse/inode.c b/fs/fuse/inode.c
--- a/fs/fuse/inode.c	2026-10-13 18:02:28
+++ b/fs/fuse/inode.c	2026-10-13 18:02:28
@@ -1359,6 +1359,12 @@
 
 		fm->sb->s_bdi->ra_pages =
 				min(fm->sb->s_bdi->ra_pages, ra_pages);
+		/*
+		 * Sequential reads use the whole window the server granted.
+		 * The block-layer default is 128 KiB; fc->max_pages is up to 1 MiB.
+		 */
+		if (fc->max_pages > fm->sb->s_bdi->ra_pages)
+			fm->sb->s_bdi->ra_pages = fc->max_pages;
 		fc->minor = arg->minor;
 		fc->max_write = arg->minor < 5 ? 4096 : arg->max_write;
 		fc->max_write = max_t(unsigned, 4096, fc->max_write);
diff -ruN a/fs/fuse/pvisor_meta.c b/fs/fuse/pvisor_meta.c
--- a/fs/fuse/pvisor_meta.c	2026-10-13 18:02:28
+++ b/fs/fuse/pvisor_meta.c	2026-10-13 18:02:28
@@ -4,8 +4,9 @@
  *
  * The host publishes one merged directory page at a time. This cache answers
  * lookup, readdir, and read-only open from that image. A name that is not in
- * a finished image is absent. A missing page, a read, and every stage change
- * still go to the host. Rename drops the image and the next lookup uses the
+ * a finished image is absent. A missing page is one request of the negotiated
+ * FUSE budget, at most 1 MiB. File bytes and every stage change still go to
+ * the host. Rename drops the image and the next lookup uses the
  * host, because exchanging two directories safely is the host overlay's job.
  */
 
@@ -13,10 +14,13 @@
 
 #include <linux/mutex.h>
 #include <linux/slab.h>
+#include <linux/vmalloc.h>
 
 #define PVISOR_MAX_ENTRIES 65536
 #define PVISOR_MAX_PAGES 32
 #define PVISOR_VALID_SEC 86400ULL
+/* Matches FUSE_MAX_MAX_PAGES and the host's 1 MiB request buffer. */
+#define PVISOR_MAX_TRANSFER_PAGES 256U
 
 struct pvisor_entry {
 	struct rb_node node;
@@ -424,17 +428,44 @@
 	return 0;
 }
 
+static unsigned int pvisor_transfer_bytes(struct fuse_conn *fc)
+{
+	unsigned int pages = fc->max_pages;
+
+	if (pages < 1)
+		pages = 1;
+	if (pages > PVISOR_MAX_TRANSFER_PAGES)
+		pages = PVISOR_MAX_TRANSFER_PAGES;
+	return pages << PAGE_SHIFT;
+}
+
+static void pvisor_free_pages(struct page **pages, unsigned int npages,
+			      struct fuse_page_desc *descs)
+{
+	unsigned int i;
+
+	if (pages) {
+		for (i = 0; i < npages; i++) {
+			if (pages[i])
+				__free_page(pages[i]);
+		}
+		kvfree(pages);
+	}
+	kvfree(descs);
+}
