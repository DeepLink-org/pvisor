From: pVisor maintainers
Subject: [PATCH] fuse: bound directory prefetch by useful demand

Cache READINDEX rejection per connection, preserve concurrent lookup ownership,
and admit bounded lookup prefetch only after demand for different names. Grow
useful windows to the negotiated budget; invalidate partial images on mutation.

diff --git a/fs/fuse/dir.c b/fs/fuse/dir.c
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -269,6 +269,20 @@
 			fuse_advise_use_readdirplus(d_inode(parent));
 			dput(parent);
 		}
+	}
+	if (inode && test_bit(FUSE_I_PVISOR_PREFETCHED,
+			      &get_fuse_inode(inode)->state) &&
+	    test_and_clear_bit(FUSE_I_PVISOR_PREFETCHED,
+			       &get_fuse_inode(inode)->state)) {
+		struct inode *dir;
+
+		/* Only inode state is touched: directory images can be evicted. */
+		rcu_read_lock();
+		parent = READ_ONCE(entry->d_parent);
+		dir = d_inode_rcu(parent);
+		if (dir && dir->i_sb == inode->i_sb)
+			atomic_inc(&get_fuse_inode(dir)->pvisor_prefetch_hits);
+		rcu_read_unlock();
 	}
 	ret = 1;
 out:
