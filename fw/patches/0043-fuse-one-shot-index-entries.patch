From: pVisor <pvisor@local>
Subject: fuse: preserve host lookup for one-shot directory index entries

Zero entry-validity marks a lookup-only name. Keep it in the directory
image so COMPLETE cannot hide it, but do not instantiate or list it:
LOOKUP must reach the host to consume its one-shot name. Reject replies
outside the page budget and incomplete replies that make no progress.

--- a/fs/fuse/pvisor_meta.c
+++ b/fs/fuse/pvisor_meta.c
@@ -35,6 +35,7 @@
 	bool whiteout;
 	bool local;
 	bool accounted;
+	bool lookup_only;
 	struct fuse_attr attr;
 	char name[];
 };
@@ -332,7 +333,7 @@
 		size_t reclen = FUSE_DIRENTPLUS_SIZE(direntplus);
 		struct qstr name = QSTR_INIT(dirent->name, dirent->namelen);
 		struct pvisor_entry *entry, *existing;
-		bool active;
+		bool active, lookup_only;
 
 		if (!dirent->namelen || dirent->namelen > FUSE_NAME_MAX ||
 		    reclen > len ||
@@ -354,6 +355,9 @@
 		entry->ino = dirent->ino;
 		entry->type = dirent->type;
 		entry->attr = direntplus->entry_out.attr;
+		lookup_only = !direntplus->entry_out.entry_valid &&
+			      !direntplus->entry_out.entry_valid_nsec;
+		entry->lookup_only = lookup_only;
 
 		mutex_lock(&pd->lock);
 		if (pd->passthrough || pd->count >= PVISOR_MAX_ENTRIES) {
@@ -386,6 +390,13 @@
 			return -EIO;
 		}
 		mutex_unlock(&pd->lock);
+
+		/* One-shot names must be consumed by the host LOOKUP. */
+		if (lookup_only) {
+			pvisor_forget_one(fm, direntplus->entry_out.nodeid);
+			pvisor_mark(pd, &name);
+			continue;
+		}
 
 		if (active) {
 			have_skip = true;
@@ -525,7 +536,7 @@
 		}
 		goto out;
 	}
-	if (res < (ssize_t)sizeof(struct fuse_readindex_out)) {
+	if (res < (ssize_t)sizeof(struct fuse_readindex_out) || res > budget) {
 		err = -EIO;
 		goto out;
 	}
@@ -536,8 +547,7 @@
 	}
 	hdr = mapped;
 	complete = hdr->flags & FUSE_READINDEX_COMPLETE;
-	if (!complete && hdr->next_offset <= offset &&
-	    res > (ssize_t)sizeof(*hdr)) {
+	if (!complete && hdr->next_offset <= offset) {
 		err = -EIO;
 		goto out;
 	}
@@ -597,6 +607,10 @@
 			break;
 		}
 		found = pvisor_find(pd, &entry->d_name);
+		if (found && found->lookup_only) {
+			err = -EAGAIN;
+			break;
+		}
 		if (found && found->whiteout) {
 			pvisor_negative(outarg);
 			err = 0;
@@ -809,7 +823,7 @@
 		return err ? err : -EAGAIN;
 	}
 	list_for_each_entry(entry, &pd->order, list) {
-		if (entry->whiteout || entry->cookie <= ctx->pos)
+		if (entry->lookup_only || entry->whiteout || entry->cookie <= ctx->pos)
 			continue;
 		if (!dir_emit(ctx, entry->name, entry->namelen, entry->ino,
 			      entry->type))
