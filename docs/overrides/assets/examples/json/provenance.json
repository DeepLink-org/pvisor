    "timeout-run": [
      "run",
      "--safe",
      "--overlaynet-deny-all",
      "--stdio",
      "capture",
      "--stage",
      "/tmp/pvisor-example/timeout-run",
      "--timeout",
      "100ms",
      "--",
      "/bin/sh",
      "-c",
      "printf \"candidate\\n\" > timed.txt; sleep 2"
    ]
