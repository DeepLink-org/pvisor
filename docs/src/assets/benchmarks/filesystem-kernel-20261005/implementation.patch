+                .unwrap()
+                .unwrap()
+                .0
+                .unwrap();
+            first.join().unwrap();
+            fs.release(ctx, b, libc::O_RDONLY as u32, bh, false, false, None)
+                .unwrap();
+            fs.release(ctx, b, libc::O_RDWR as u32, wh, false, false, None)
