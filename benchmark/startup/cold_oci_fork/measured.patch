+pub(super) fn record<T>(index:usize, f:impl FnOnce()->T)->T {
+    let t=std::time::Instant::now();
+    let result=f();
+    let ns=t.elapsed().as_nanos() as u64;
+    TIMES.with_borrow_mut(|v| {v[index].0+=1;v[index].1+=ns;});
+    result
+}
