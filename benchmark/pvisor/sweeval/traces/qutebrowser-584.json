wser/config/configdata.yml","cwd":"/app","env":{"LESS":"-R","MANPAGER":"cat","PAGER":"cat","PIP_PROGRESS_BAR":"off","TQDM_DISABLE":"1"},"expected":{"return_code":0,"stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","timed_out":false},"timeout":120,"user":null},"end_ns":149246413303,"start_ns":148968441911,"step":38,"wait_before_ns":60436672795},{"command":{"command":"python3 << 'ENDPYTHON'\nimport re\n\n# Read the original file\nwith open('/app/qutebrowser/config/qtargs.py', 'r') as f:\n    original = f.read()\n\nlines = original.splitlines(keepends=True)\n\n# 1. Insert imports after 'from typing import ...' line\ntyping_indices = [i for i, line in enumerate(lines) if line.startswith('from typing import ')]\nif typing_indices:\n    idx = typing_indices[0]\n    lines.insert(idx+1, 'import pathlib\\n')\n    lines.insert(idx+2, 'from PyQt5.QtCore import QLocale, QLibraryInfo\\n')\n\n# 2. Helper functions\nhelpers = '''def _get_locale_pak_path(locales_path: pathlib.Path, locale_name: str) -> pathlib.Path:\n    \"\"\"Construct the filesystem path to a locale's .pak file.\"\"\"\n    return locales_path / f\"{locale_name}.pak\"\n\n\ndef _get_pak_name(locale_name: str) -> str:\n    \"\"\"Map BCP-47 locale to Chromium's expected .pak locale.\"\"\"\n    # en/en-PH/en-LR → en-US\n    if locale_name in (\"en\", \"en-PH\", \"en-LR\"):\n        return \"en-US\"\n    # any en-* → en-GB\n    if locale_name.startswith(\"en-\"):\n        return \"en-GB\"\n    # any es-* → es-419\n    if locale_name.startswith(\"es-\"):\n        return \"es-419\"\n    # exactly pt → pt-BR\n    if locale_name == \"pt\":\n        return \"pt-BR\"\n    # any pt-* → pt-PT\n    if locale_name.startswith(\"pt-\"):\n        return \"pt-PT\"\n    # zh-HK/zh-MO → zh-TW\n    if locale_name in (\"zh-HK\", \"zh-MO\"):\n        return \"zh-TW\"\n    # exactly zh or any zh-* → zh-CN\n    if locale_name == \"zh\" or locale_name.startswith(\"zh-\"):\n        return \"zh-CN\"\n    # otherwise base language before hyphen\n    idx = locale_name.find(\"-\")\n    if idx != -1:\n        return locale_name[:idx]\n    return locale_name\n\n\ndef _get_lang_override(webengine_version: utils.VersionNumber, locale_name: str) -> Optional[str]:\n    \"\"\"Get a language override for Chromium if needed.\"\"\"\n    # Only consider on Linux and only for QtWebEngine 5.15.3\n    if not utils.is_linux:\n        return None\n    if webengine_version != utils.VersionNumber(5, 15, 3):\n        return None\n    # Check config value\n    if not config.val.qt.workarounds.locale:\n        return None\n\n    # Get locales directory\n    locales_path = pathlib.Path(QLibraryInfo.location(QLibraryInfo.TranslationsPath)) / \"qtwebengine_locales\"\n    if not locales_path.exists():\n        log.init.debug(f\"{locales_path} not found, skipping workaround!\")\n        return None\n\n    # Check if original locale's .pak exists\n    original_pak = _get_locale_pak_path(locales_path, locale_name)\n    if original_pak.exists():\n        log.init.debug(f\"Found {original_pak}, skipping workaround\")\n        return None\n\n    # Compute fallback\n    pak_name = _get_pak_name(locale_name)\n    fallback_pak = _get_locale_pak_path(locales_path, pak_name)\n    if fallback_pak.exists():\n        log.init.debug(f\"Found {fallback_pak}, applying workaround\")\n        return pak_name\n\n    # Not found at all\n    log.init.debug(f\"Can't find pak in {locales_path} for {locale_name} or {pak_name}\")\n    return \"en-US\"\n'''\n\n# Find first occurrence of 'def qt_args('\nqt_args_indices = [i for i, line in enumerate(lines) if line.startswith('def qt_args(')]\nif qt_args_indices:\n    idx = qt_args_indices[0]\n    helpers_lines = helpers.splitlines(keepends=True)\n    for i, hline in enumerate(helpers_lines):\n        lines.insert(idx + i, hline)\n\n# 3. Insert lang override code after 'yield from _qtwebengine_settings_args(versions)'\nfor i, line in enumerate(lines):\n    if 'yield from _qtwebengine_settings_args(versions)' in line:\n        # Get indentation of this line\n        indent = line[:len(line) - len(line.lstrip())]\n        lang_code = f'''\n{indent}# Workaround for QtWebEngine 5.15.3 locale parsing issues on Linux\n{indent}locale_name = QLocale().bcp47Name()\n{indent}lang_override = _get_lang_override(versions.webengine, locale_name)\n{indent}if lang_override is not None:\n{indent}    yield f\"--lang={{lang_override}}\"\n'''\n        lang_lines = lang_code.splitlines(keepends=True)\n        for j, lline in enumerate(lang_lines):\n            lines.insert(i + 1 + j, lline)\n        break\n\n# Write back\nwith open('/app/qutebrowser/config/qtargs.py', 'w') as f:\n    f.write(''.join(lines))\n\nprint(\"Modified qtargs.py successfully.\")\nENDPYTHON","cwd":"/app","env":{"LESS":"-R","MANPAGER":"cat","PAGER":"cat","PIP_PROGRESS_BAR":"off","TQDM_DISABLE":"1"},"expected":{"return_code":0,"stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"fde8d9d1156bda6ae1856dddf4d9c123fd018048a31f9f986e511b5d38bdf2a6","timed_out":false},"timeout":120,"user":null},"end_ns":163194553682,"start_ns":162872592481,"step":39,"wait_before_ns":13626179178},{"command":{"command":"head -35 /app/qutebrowser/config/qtargs.py","cwd":"/app","env":{"LESS":"-R","MANPAGER":"cat","PAGER":"cat","PIP_PROGRESS_BAR":"off","TQDM_DISABLE":"1"},"expected":{"return_code":0,"stderr_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","stdout_sha256":"8b19711002646ecc9310882f9731a2a8567aef2608678608c398c92e082da381","timed_out":false},"timeout":120,"user":null},"end_ns":164541204097,"start_ns":164343284418,"step":40,"wait_before_ns":1148730736},{"command":{"command":"sed -n '60,90p' /app/qutebrowser/config/qtargs.py","cwd":"/app","env":{"LESS":"-R","MANPAGER":"cat","PAGER":"cat","PIP_PROGRESS_BAR":"off","TQDM_DISABLE":"1"},"expected":{"return